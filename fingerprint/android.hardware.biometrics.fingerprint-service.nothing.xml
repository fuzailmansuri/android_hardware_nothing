<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <version>4</version>
        <fqname>IFingerprint/default</fqname>
    </hal>
    <!-- IGoodixFingerprintDaemon/default is provided by
         vendor.nothing.hardware.biometrics.fingerprint-service; declaring it
         here as well conflicts at VINTF assembly. This service consumes it
         via ServiceManager lookup, which needs no fragment entry. -->
</manifest>
